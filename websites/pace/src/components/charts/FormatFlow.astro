---
// What the analyzer consumes and what it emits. A flow diagram, not a
// measurement: every box names a real command or a real format.
const inputs = [
  { label: 'PACE JSONL', from: 'the SDK\u2019s own writer' },
  { label: 'Chrome Trace Event', from: 'the standard trace format' },
  { label: 'perf sched timehist', from: 'perf\u2019s scheduling analysis' },
  { label: 'perf trace', from: 'perf\u2019s event trace' },
];

const outputs = [
  { label: 'terminal report', command: 'pace analyze' },
  { label: 'self-contained HTML', command: '--output report.html' },
  { label: 'per-thread samples', command: 'pace inspect' },
  { label: 'exit code', command: 'pace verify' },
];

const width = 900;
const height = 250;
const colW = 230;
const centre = 450;
---

<figure class="chart">
  <figcaption>
    <span>Every format in, four outputs out, one arithmetic in the middle</span>
    <span class="src">pace-analyzer/README.md · pace --help</span>
  </figcaption>
  <div class="plot">
    <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label="Four trace formats feed one analyzer, which emits a terminal report, an HTML report, per-thread samples and an exit code">
      {
        inputs.map((item, i) => {
          const y = 14 + i * 56;
          return (
            <g>
              <rect x="10" y={y} width={colW} height="40" rx="3" fill="var(--panel-raised)" stroke="var(--line-strong)" />
              <text x="22" y={y + 18} font-size="12" fill="var(--ink)">{item.label}</text>
              <text x="22" y={y + 32} font-size="10" fill="var(--ink-faint)">{item.from}</text>
              <path d={`M ${colW + 14} ${y + 20} C ${centre - 90} ${y + 20}, ${centre - 90} 125, ${centre - 74} 125`} fill="none" stroke="var(--line-strong)" stroke-width="1" />
            </g>
          );
        })
      }

      <g>
        <rect x={centre - 76} y="88" width="152" height="74" rx="3" fill="var(--panel-raised)" stroke="var(--accent)" stroke-width="1" />
        <text x={centre} y="116" font-size="13" text-anchor="middle" fill="var(--ink)">pace-analyzer</text>
        <text x={centre} y="134" font-size="10.5" text-anchor="middle" fill="var(--ink-dim)">fold per thread,</text>
        <text x={centre} y="148" font-size="10.5" text-anchor="middle" fill="var(--ink-dim)">check the invariant</text>
      </g>

      {
        outputs.map((item, i) => {
          const y = 14 + i * 56;
          return (
            <g>
              <path d={`M ${centre + 78} 125 C ${centre + 130} 125, ${centre + 130} ${y + 20}, ${centre} +160 ${y + 20}`} fill="none" stroke="var(--line-strong)" stroke-width="1" />
              <rect x={width - 236} y={y} width="226" height="40" rx="3" fill="var(--panel-raised)" stroke="var(--line-strong)" />
              <text x={width - 224} y={y + 18} font-size="12" fill="var(--ink)">{item.label}</text>
              <text x={width - 224} y={y + 32} font-size="10" fill="var(--ink-faint)">{item.command}</text>
            </g>
          );
        })
      }

      <text x="10" y="244" font-size="10.5" fill="var(--ink-faint)">reads line by line; memory is proportional to the thread count, not the sample count</text>
    </svg>
  </div>
  <div class="chart-note">
    <p>
      A format that carries no attribution — a plain Chrome trace, say — is reported as carrying
      none: the split columns print a dash, the bar is drawn empty, and no finding is raised
      against that thread. Nothing on this path invents a zero.
    </p>
  </div>
</figure>
