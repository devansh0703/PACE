---
// The distribution of preempted share across the threads of the recorded run.
// The stacked bars show that every thread lost roughly the same amount; this
// shows how narrow that band is, which is the quantitative version of the
// same claim.
import { threads, pct } from '../../data/measurements';

const values = threads.map((t) => t.preemptPct);
const min = Math.floor(Math.min(...values) * 2) / 2;
const max = Math.ceil(Math.max(...values) * 2) / 2;
const binWidth = 0.5;
const binCount = Math.max(1, Math.round((max - min) / binWidth));
const bins = Array.from({ length: binCount }, (_, i) => ({
  from: min + i * binWidth,
  to: min + (i + 1) * binWidth,
  count: 0,
}));
for (const v of values) {
  const index = Math.min(binCount - 1, Math.max(0, Math.floor((v - min) / binWidth)));
  bins[index].count += 1;
}

const sorted = [...values].sort((a, b) => a - b);
const mid = Math.floor(sorted.length / 2);
const median = sorted.length % 2 ? sorted[mid] : (sorted[mid - 1] + sorted[mid]) / 2;
const spread = sorted[sorted.length - 1] - sorted[0];

const width = 900;
const left = 40;
const right = 16;
const top = 20;
const plotHeight = 180;
const usable = width - left - right;
const barSlot = usable / binCount;
const barWidth = barSlot * 0.72;
const maxCount = Math.max(...bins.map((b) => b.count));
const plotBottom = top + plotHeight;
const yFor = (count: number) => plotBottom - (count / maxCount) * plotHeight;
---

<figure class="chart">
  <figcaption>
    <span>How wide the preemption band is across {threads.length} threads</span>
    <span class="src">0.5 pp bins · pace-analyzer/results/real-trace-report.txt</span>
  </figcaption>
  <div class="plot">
    <svg viewBox={`0 0 ${width} ${plotBottom + 34}`} role="img" aria-label={`Histogram of preempted share across ${threads.length} threads, from ${pct(sorted[0])} to ${pct(sorted[sorted.length - 1])}`}>
      <g>
        {
          [0, 0.5, 1].map((f) => (
            <line class="grid" x1={left} y1={yFor(maxCount * f)} x2={left + usable} y2={yFor(maxCount * f)} />
          ))
        }
        <line class="axis" x1={left} y1={plotBottom} x2={left + usable} y2={plotBottom} />
      </g>

      <g>
        {
          bins.map((b, i) => {
            const x = left + i * barSlot + (barSlot - barWidth) / 2;
            const y = yFor(b.count);
            return (
              <g>
                <rect x={x} y={y} width={barWidth} height={plotBottom - y} fill="var(--sev-critical)" opacity="0.85" />
                <text x={x + barWidth / 2} y={y - 4} font-size="10" text-anchor="middle">{b.count}</text>
                <text x={x + barWidth / 2} y={plotBottom + 14} font-size="10" text-anchor="middle">{b.from.toFixed(1)}</text>
              </g>
            );
          })
        }
      </g>

      <g>
        <line x1={left + ((median - min) / binWidth) * barSlot} y1={top - 6} x2={left + ((median - min) / binWidth) * barSlot} y2={plotBottom} stroke="var(--ink)" stroke-dasharray="3 3" />
        <text x={left + ((median - min) / binWidth) * barSlot + 6} y={top + 2} font-size="11">median {pct(median)}</text>
      </g>

      <g font-size="11" fill="var(--ink-dim)">
        <text x={left} y={plotBottom + 30}>preempted share of wall time, per cent</text>
        <text x={left + usable} y={plotBottom + 30} text-anchor="end">spread {pct(spread)} across {threads.length} threads</text>
      </g>
    </svg>
  </div>
  <div class="chart-note">
    <p>
      A spread of {pct(spread)} across {threads.length} threads is the signature of a queue, not
      of a bug: the threads are interchangeable and the scheduler treats them that way. That is
      why the finding is about the run's thread count rather than about any one thread's code.
    </p>
  </div>
</figure>
