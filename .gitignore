# Build output. The trailing slashes matter: they match directories
# only, so a file named build_release_asset.sh is not ignored.
build/
build-*/
build_*/
dist/
target/
node_modules/
*.o
*.a
*.so
*.dylib
*.dll
compile_commands.json

# The SDK's generated eBPF skeleton, and the kernel's BTF dump it is
# generated from. Both are build outputs, and both are large.
pace-sdk/src/bpf/skel/
pace-sdk/src/bpf/vmlinux.h
pace-sdk/src/bpf/*.skel.h

# Editor and OS noise
.vscode/
.idea/
.DS_Store
*.swp

# Python's bytecode cache
__pycache__/
*.pyc

# Credentials. This file holds the Render API key and is read by the
# deployment scripts. It is a secret that happens to live in the repository
# root, so it is ignored rather than committed.
.env
.env.*
!.env.example
